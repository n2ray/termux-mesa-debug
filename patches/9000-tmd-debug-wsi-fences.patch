diff --git a/src/util/tmd_debug.h b/src/util/tmd_debug.h
new file mode 100644
index 0000000..0c0da11
--- /dev/null
+++ b/src/util/tmd_debug.h
@@ -0,0 +1,138 @@
+/*
+ * TMD-DEBUG (termux-mesa-debug): temporary instrumentation for the
+ * "no render fence on presented dma-bufs" investigation.  NOT for upstream.
+ *
+ * Inactive unless the environment variable TMD_DEBUG=1 is set.  Lines go to
+ * stderr and, if TMD_LOG names a file, are appended to that file too.
+ */
+#ifndef TMD_DEBUG_H
+#define TMD_DEBUG_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+
+#include "util/libsync.h"
+
+static inline bool
+tmd_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *e = getenv("TMD_DEBUG");
+      enabled = (e && strcmp(e, "1") == 0) ? 1 : 0;
+   }
+   return enabled == 1;
+}
+
+/* TMD_FORCE_FENCE_WAIT=1 (independent of TMD_DEBUG): the X11 WSI waits on the
+ * CPU for the frame's render fence before sending PresentPixmap, in every
+ * present mode.  Diagnostic only: if tearing persists with it, the X server
+ * reads/reuses buffers wrongly; if it disappears, render fences are the issue.
+ */
+static inline bool
+tmd_force_fence_wait(void)
+{
+   static int force = -1;
+   if (force < 0) {
+      const char *e = getenv("TMD_FORCE_FENCE_WAIT");
+      force = (e && strcmp(e, "1") == 0) ? 1 : 0;
+   }
+   return force == 1;
+}
+
+/* First 20 events, then every 300th. */
+static inline bool
+tmd_rate_ok(unsigned n)
+{
+   return n <= 20 || n % 300 == 0;
+}
+
+static inline void
+tmd_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+
+static inline void
+tmd_log(const char *fmt, ...)
+{
+   if (!tmd_enabled())
+      return;
+
+   int saved_errno = errno;
+   static int log_fd = -2;
+   if (log_fd == -2) {
+      const char *path = getenv("TMD_LOG");
+      log_fd = (path && *path) ?
+         open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644) : -1;
+   }
+
+   char buf[1024];
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   int n = snprintf(buf, sizeof(buf), "TMD %ld.%03ld pid=%d: ",
+                    (long)ts.tv_sec, (long)(ts.tv_nsec / 1000000),
+                    (int)getpid());
+   va_list ap;
+   va_start(ap, fmt);
+   int m = vsnprintf(buf + n, sizeof(buf) - n - 1, fmt, ap);
+   va_end(ap);
+   if (m < 0)
+      m = 0;
+   n += m;
+   if (n > (int)sizeof(buf) - 2)
+      n = sizeof(buf) - 2;
+   buf[n++] = '\n';
+
+   ssize_t ignored = write(STDERR_FILENO, buf, n);
+   if (log_fd >= 0)
+      ignored = write(log_fd, buf, n);
+   (void)ignored;
+   errno = saved_errno;
+}
+
+/* Describe a sync_file fd: overall status and up to 4 fences (driver:status). */
+static inline const char *
+tmd_sync_file_desc(int fd, char *out, size_t len)
+{
+   if (fd < 0) {
+      snprintf(out, len, "none(fd=%d)", fd);
+      return out;
+   }
+
+   struct sync_fence_info fences[4];
+   struct sync_file_info info;
+   memset(&info, 0, sizeof(info));
+   if (ioctl(fd, SYNC_IOC_FILE_INFO, &info) != 0) {
+      snprintf(out, len, "FILE_INFO-failed(errno=%d %s)", errno, strerror(errno));
+      return out;
+   }
+   uint32_t total = info.num_fences;
+   uint32_t want = total < 4 ? total : 4;
+   memset(fences, 0, sizeof(fences));
+   memset(&info, 0, sizeof(info));
+   info.num_fences = want;
+   info.sync_fence_info = (uint64_t)(uintptr_t)fences;
+   if (want && ioctl(fd, SYNC_IOC_FILE_INFO, &info) != 0)
+      want = 0;
+
+   int n = snprintf(out, len, "%s n=%u [",
+                    info.status == 1 ? "signaled" :
+                    info.status == 0 ? "PENDING" : "error", total);
+   for (uint32_t i = 0; i < want && n > 0 && (size_t)n < len; i++) {
+      n += snprintf(out + n, len - n, "%s%.32s/%.32s:%s", i ? " " : "",
+                    fences[i].driver_name, fences[i].obj_name,
+                    fences[i].status == 1 ? "signaled" :
+                    fences[i].status == 0 ? "pending" : "error");
+   }
+   if (n > 0 && (size_t)n < len)
+      snprintf(out + n, len - n, "]");
+   return out;
+}
+
+#endif /* TMD_DEBUG_H */
